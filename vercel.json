{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "sh scripts/vercel-ignore.sh",
  "rewrites": [
    { "source": "/rules", "destination": "/rules/index.html" },
    { "source": "/rules/:slug", "destination": "/rules/:slug/index.html" },
    { "source": "/roadmap", "destination": "/index.html" },
    { "source": "/terms", "destination": "/terms.html" }
  ],
  "functions": {
    "api/push-ideas.js": { "includeFiles": "ROADMAP.md" }
  },
  "crons": [
    { "path": "/api/push-tee", "schedule": "0 15 * * *" },
    { "path": "/api/push-ideas", "schedule": "0 17 * * *" }
  ]
}

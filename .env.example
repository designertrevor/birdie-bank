# Shared live scoring (Supabase → Project Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Course search (GolfCourseAPI). Server-only: set GOLFCOURSEAPI_KEY in Vercel's
# environment variables, never with a VITE_ prefix, so it stays out of the app bundle.
GOLFCOURSEAPI_KEY=
# Dev only: search made-up courses from src/data/courseApiSamples.js in `npm run dev`
VITE_COURSE_SAMPLES=1

# Crash reports (Sentry, sentry.io: Settings, Projects, your project, Client Keys (DSN)). Off when
# empty: nothing loads. Public by design, like the Supabase key: it only lets the app send events.
VITE_SENTRY_DSN=
# Usage counts (PostHog: Project settings, Project API key, starts with phc_). Off when empty.
VITE_POSTHOG_KEY=
# Only for the EU cloud or your own PostHog; the US cloud is the default
VITE_POSTHOG_HOST=https://us.i.posthog.com
